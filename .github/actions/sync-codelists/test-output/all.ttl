<https://www.w3.org/ns/adms#status> <https://wegenenverkeer.data.vlaanderen.be/id/concept/KlAdmsStatus/ingebruik>;
  skos:definition "Verschillende soorten wegmarkeringen zullen trillingen en geluid produceren bij het overrijden. Zo zijn er ribbelmarkeringen, ribbelstrips en ribbelstroken."@nl;
  skos:inScheme <https://wegenenverkeer.data.vlaanderen.be/id/conceptscheme/KlMarkeringssysteem>;
