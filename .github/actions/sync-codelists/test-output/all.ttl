  skos:definition "De mogelijke markeringssystemen."@nl;
  skos:prefLabel "Markeringssysteem"@nl.

<https://wegenenverkeer.data.vlaanderen.be/id/concept/KlMarkeringssysteem/vlak> a skos:Concept;
<https://www.w3.org/ns/adms#status> <https://wegenenverkeer.data.vlaanderen.be/id/concept/KlAdmsStatus/ingebruik>;
  skos:definition "Een vlak systeem is een film met constante dosering. De wegmarkering wordt nagestrooid met kleine glasparels. "@nl;
  skos:inScheme <https://wegenenverkeer.data.vlaanderen.be/id/conceptscheme/KlMarkeringssysteem>;
  skos:notation "vlak";
  skos:prefLabel "Vlak"@nl;
  skos:topConceptOf <https://wegenenverkeer.data.vlaanderen.be/id/conceptscheme/KlMarkeringssysteem> .

<https://wegenenverkeer.data.vlaanderen.be/id/concept/KlMarkeringssysteem/geprofileerd> a skos:Concept;
<https://www.w3.org/ns/adms#status> <https://wegenenverkeer.data.vlaanderen.be/id/concept/KlAdmsStatus/ingebruik>;
  skos:definition "Geprofileerde systemen hebben in dwars- en of lengterichting veranderlijke filmdikte. Hierdoor ontstaat een reliëf met een wisselende hoogte."@nl;
  skos:inScheme <https://wegenenverkeer.data.vlaanderen.be/id/conceptscheme/KlMarkeringssysteem>;
  skos:notation "geprofileerd";
  skos:prefLabel "Geprofileerd"@nl;
