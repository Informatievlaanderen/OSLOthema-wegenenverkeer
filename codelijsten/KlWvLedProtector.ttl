<https://www.w3.org/ns/adms#status> <https://wegenenverkeer.data.vlaanderen.be/id/concept/KlAdmsStatus/ingebruik>;
  skos:definition "Type doorschijnende kap ter bescherming van de LED's (vlak glas, polycarbonaat,...)."@nl;
  skos:prefLabel "WV protector"@nl.

<https://wegenenverkeer.data.vlaanderen.be/id/concept/KlWvLedProtector/vlak-glas> a skos:Concept;
