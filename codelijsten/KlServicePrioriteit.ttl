  skos:prefLabel "niet prioritair"@nl;
  skos:topConceptOf <https://wegenenverkeer.data.vlaanderen.be/id/conceptscheme/KlServicePrioriteit> .

<https://wegenenverkeer.data.vlaanderen.be/id/concept/KlServicePrioriteit/prioritair> a skos:Concept;
